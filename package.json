{
  "name": "greenhat-tools-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:regression": "npx ts-node scripts/regression-tests.ts",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t greenhat-tools-admin .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local greenhat-tools-admin",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.1",
    "@supabase/supabase-js": "^2.91.0",
    "lucide-react": "^0.460.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^1.0.0"
  }
}
