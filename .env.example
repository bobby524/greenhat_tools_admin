# ──────────────────────────────────────────────────────────────
# API_MCP_Gateway — Environment Variables
# Copy to .env and fill in real values.  NEVER commit .env itself.
# ──────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
PORT=8080
RUST_LOG=gateway=debug,tower_http=debug

# ── Auth / JWT ────────────────────────────────────────────────
# REQUIRED — used to validate BetterAuth sessions & sign JWTs.
AUTH_SECRET=change-me

# ── Database ──────────────────────────────────────────────────
# REQUIRED — Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/gateway

# ── MCP Runtime ───────────────────────────────────────────────
# Comma-separated origins allowed for CORS / MCP tool calls.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# ── CSRF Protection ───────────────────────────────────────────
# Double-submit cookie CSRF for SPA cookie sessions.
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token

# ── RBAC / Policy ─────────────────────────────────────────────
# Path to policy JSON file.  When set, deny-by-default RBAC is enforced.
# See docs/schemas/policy.v0.schema.json for the schema.
# POLICY_FILE=./docs/examples/policy.local.json

# ── Auth (BetterAuth) ─────────────────────────────────────────
# When enabled, the gateway validates sessions via BetterAuth.
AUTH_ENABLED=true
BETTERAUTH_BASE_URL=http://localhost:3000
# Upstream for proxied /api/* routes. Keep separate from BetterAuth URL to avoid proxy loops.
PROXY_UPSTREAM_BASE_URL=http://localhost:3000
BETTERAUTH_COOKIE_NAME=better-auth.session_token
BETTERAUTH_TIMEOUT_MS=2000

# ── Rate Limiting ─────────────────────────────────────────────
# Requests-per-second per caller (default: 50).
RATE_LIMIT_RPS=50

# ── Redis Cache ───────────────────────────────────────────────
# Optional — set to enable the cache layer.  Omit to run without Redis.
REDIS_URL=redis://127.0.0.1:6379

# ── Egress Firewall ───────────────────────────────────────────
# Comma-separated hostnames that tools are allowed to reach.
# Empty = deny ALL outbound requests (fail-closed).
EGRESS_ALLOWED_HOSTS=api.openai.com,api.anthropic.com

# Total request timeout (seconds).  Default: 30.
EGRESS_TIMEOUT_SECS=30

# TCP connect timeout (seconds).  Default: 10.
EGRESS_CONNECT_TIMEOUT_SECS=10

# Max response body (bytes).  Default: 5242880 (5 MiB).
EGRESS_MAX_RESPONSE_BYTES=5242880

# Max request body (bytes).  Default: 1048576 (1 MiB).
EGRESS_MAX_REQUEST_BODY_BYTES=1048576

# Block private/loopback IPs (SSRF prevention).  Default: true.
EGRESS_DENY_PRIVATE_IPS=true

# ── Audit Logging ─────────────────────────────────────────────
# Optional file path for JSONL audit log output (in addition to stdout).
# Leave empty to log only to stdout.
AUDIT_LOG_FILE=

# ── Observability ─────────────────────────────────────────────
# Optional OTLP endpoint for traces/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Better Stack log shipping (gateway source of truth)
BETTERSTACK_ENABLED=false
BETTERSTACK_SOURCE_TOKEN=
# e.g. https://in.logs.betterstack.com or in.logs.betterstack.com
BETTERSTACK_INGEST_HOST=
