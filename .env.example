# Greenhat Tools Admin - Environment Configuration

# ===========================================
# Database (Supabase) - SHARED with tools.greenhatsec.com
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
crm_POSTGRES_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# ===========================================
# Better Auth Configuration
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=https://admin.greenhatsec.com

# ===========================================
# Google OAuth
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ALLOWED_DOMAIN=greenhatsec.com

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=auth@emails.greenhatsec.com

# ===========================================
# Admin MCP Authentication
# ===========================================
ADMIN_MCP_TOKEN=generate-a-secure-random-token-here

# ===========================================
# WireGuard VPN
# ===========================================
WIREGUARD_SERVER_URL=your-hetzner-ip-or-domain

# ===========================================
# App URL
# ===========================================
NEXT_PUBLIC_APP_URL=https://admin.greenhatsec.com