# Greenhat Tools Admin - Environment Configuration
# Copy this file to .env.local for local development
# For production, set these in Vercel Dashboard → Settings → Environment Variables

# ===========================================
# Database (Supabase) - SHARED with tools.greenhatsec.com
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Database connection for Better Auth
CRM_POSTGRES_URL_NON_POOLING=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
crm_POSTGRES_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# ===========================================
# Better Auth Configuration
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=https://admin.greenhatsec.com

# ===========================================
# Google OAuth
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ALLOWED_DOMAIN=greenhatsec.com

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=auth@emails.greenhatsec.com

# ===========================================
# Admin MCP Authentication
# ===========================================
# Generate with: openssl rand -hex 32
ADMIN_MCP_TOKEN=generate-a-secure-random-token-here

# ===========================================
# WireGuard VPN (optional - for Hetzner deployment)
# ===========================================
WIREGUARD_SERVER_URL=your-hetzner-ip-or-domain

# ===========================================
# App URL
# ===========================================
NEXT_PUBLIC_APP_URL=https://admin.greenhatsec.com

# ===========================================
# Optional: IP Whitelisting (comma-separated)
# ===========================================
ALLOWED_IPS=1.2.3.4,5.6.7.8
