# Greenhat Tools Admin - Environment Configuration

# ===========================================
# Database (Supabase)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Admin MCP Authentication
# ===========================================
ADMIN_MCP_TOKEN=generate-a-secure-random-token-here

# ===========================================
# Admin Web Authentication
# ===========================================
ADMIN_USERNAME=admin
# Generate with: echo -n 'your-password' | sha256sum
ADMIN_PASSWORD_HASH=sha256-hash-of-password

# ===========================================
# WireGuard VPN
# ===========================================
WIREGUARD_SERVER_URL=your-hetzner-ip-or-domain

# ===========================================
# Optional: Clerk (for future SSO integration)
# ===========================================
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
